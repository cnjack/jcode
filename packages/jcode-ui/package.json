{
  "name": "jcode-ui",
  "version": "0.2.0",
  "description": "React AI chat UI components — styled, token-driven, backend-agnostic. Streams messages, tool calls, approvals, and ask-user interactions.",
  "type": "module",
  "license": "MIT",
  "author": "jack",
  "homepage": "https://www.j-code.net/chat-ui/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnjack/jcode.git",
    "directory": "packages/jcode-ui"
  },
  "keywords": [
    "ai",
    "chat",
    "react",
    "agent",
    "llm",
    "ui",
    "components",
    "chatbot",
    "copilot",
    "assistant-ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tool-renderers": {
      "types": "./dist/toolRenderers/index.d.ts",
      "import": "./dist/toolRenderers/index.js"
    },
    "./compat.css": "./dist/compat.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js"
    },
    "./canvas.css": "./dist/canvas/canvas.css",
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js"
    },
    "./voice.css": "./dist/voice/voice.css",
    "./plugins/mermaid": {
      "types": "./dist/plugins/mermaid.d.ts",
      "import": "./dist/plugins/mermaid.js"
    },
    "./plugins/katex": {
      "types": "./dist/plugins/katex.d.ts",
      "import": "./dist/plugins/katex.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "pnpm build:css && tsc -p tsconfig.build.json && cp src/voice/voice.css dist/voice/voice.css && cp src/canvas/canvas.css dist/canvas/canvas.css",
    "build:css": "tailwindcss -i src/styles/entry.css -o dist/styles.css --minify && node scripts/generate-compat-css.mjs && cp src/styles/shadcn.css dist/shadcn.css",
    "dev:css": "tailwindcss -i src/styles/entry.css -o dist/styles.css --watch",
    "dev": "pnpm dev:css & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:api-docs": "node ../../script/generate_jcode_ui_api_docs.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.11.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "mermaid": ">=10",
    "katex": ">=0.16"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "jcode-ui-core": "workspace:*",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@xyflow/react": "^12.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2"
  }
}
